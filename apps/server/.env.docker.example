# Docker 部署用环境变量样例。
# 用法：cp apps/server/.env.docker.example apps/server/.env.docker，然后修改密码。
# .env.docker 已被 .gitignore 忽略，绝不要提交；也不要把它放进镜像构建上下文。

# 必填：loadConfig() 会在密码为空时拒绝启动。
FFM_ADMIN_USERNAME=admin
FFM_ADMIN_PASSWORD=CHANGE_ME_use_a_long_random_password

# 会话有效期（小时）。后端会话存在内存里，容器重启后所有登录态失效。
FFM_SESSION_TTL_HOURS=8

# 下面三项由 docker-compose.yml 的 environment 固定覆盖，不要在此填写：
# FFM_HOST=0.0.0.0        （config.ts 默认 127.0.0.1，容器内必须改）
# FFM_PORT=3001
# FFM_DATA_DIR=/app/data  （对应 named volume ffm-data）

# SMTP 可选。全部留空时 /api/mail/* 返回 503，其余功能不受影响。
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
