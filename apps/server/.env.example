# 复制本文件为 .env.local 并替换成自己的本地密码；.env.local 已被 .gitignore 忽略，不要提交
FFM_ADMIN_USERNAME=admin
FFM_ADMIN_PASSWORD=replace-with-your-own-password
FFM_PORT=3001
FFM_HOST=127.0.0.1
FFM_DATA_DIR=data
FFM_SESSION_TTL_HOURS=8

# SMTP 邮件发送配置（用于邮件发送功能）
# 示例：QQ 邮箱 SMTP
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@qq.com
SMTP_PASS=your-smtp-auth-code
SMTP_FROM=your-email@qq.com
