# Caddy TLS 终结：只把 /api/* 转发给后端，其余路径一律 404。
# 域名来自环境变量 FFM_API_DOMAIN（docker-compose.yml 的 caddy 服务注入）。
# Caddy 会自动为该域名申请并续期 Let's Encrypt 证书，需保证 80/443 可达。

{$FFM_API_DOMAIN} {
	@api path /api/*

	reverse_proxy @api server:3001 {
		# 保留原始 Host，便于后端日志与后续 trustProxy 判断
		header_up Host {host}
		header_up X-Forwarded-Proto {scheme}
	}

	respond "Not found" 404
}
