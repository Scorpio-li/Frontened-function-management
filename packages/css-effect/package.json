{
  "name": "@repo/css-effect",
  "version": "0.1.0",
  "description": "CSS 效果平台模块：分类管理、分类下效果浏览、代码一键复制",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-router-dom": ">=7.0.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "react": "catalog:",
    "react-router-dom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}
